{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "customer": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      }
    },
    "status": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "business" } } },
      "then": { "required": ["taxId"] }
    }
  ],
  "$defs": {
    "User": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" }
      }
    }
  }
}
